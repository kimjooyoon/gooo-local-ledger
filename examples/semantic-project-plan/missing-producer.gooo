package semanticprojectplanmissing
namespace semanticprojectplanmissing

entity MissingProjectIntent id "local://semantic-project-plan/missing/project-intent"
entity PlannedWork id "local://semantic-project-plan/missing/planned-work"

activity PlanWithoutIntent(MissingProjectIntent) -> PlannedWork computes "claim.edge:requires|work-requires-missing-project-intent"
